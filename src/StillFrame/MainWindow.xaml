</StackPanel></ScrollViewer></TabItem><TabItem Header="线条与尺寸"><ScrollViewer Width="{Binding ActualWidth, ElementName=InspectorTabs}" HorizontalAlignment="Left" VerticalScrollBarVisibility="Auto" Padding="0,12,8,0"><StackPanel><Border Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="03  线条与尺寸" Style="{StaticResource SectionTitle}" FontSize="15"/><TextBlock x:Name="OpacityLabel" Style="{StaticResource FormLabel}"/><Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1" TickFrequency="0.05" ValueChanged="SliderChanged"/><TextBlock x:Name="LineWidthLabel" Style="{StaticResource FormLabel}"/><Slider x:Name="LineWidthSlider" Minimum="0.75" Maximum="3" TickFrequency="0.25" ValueChanged="SliderChanged"/><TextBlock x:Name="InsetLabel" Style="{StaticResource FormLabel}"/><Slider x:Name="InsetSlider" Minimum="0.03" Maximum="0.18" TickFrequency="0.01" ValueChanged="SliderChanged"/><TextBlock x:Name="MarkerSizeLabel" Style="{StaticResource FormLabel}"/><Slider x:Name="MarkerSizeSlider" Minimum="8" Maximum="48" TickFrequency="2" ValueChanged="SliderChanged"/><CheckBox x:Name="FilledCheck" Content="实心三角 / 菱形" Click="SettingsChanged" FontSize="12"/><TextBlock x:Name="RingSizeLabel" Style="{StaticResource FormLabel}" Margin="0,12,0,0"/><Slider x:Name="RingSizeSlider" Minimum="8" Maximum="64" TickFrequency="2" ValueChanged="SliderChanged"/><TextBlock Text="线条样式" Style="{StaticResource FormLabel}"/><ComboBox x:Name="PatternPicker" SelectionChanged="SettingsChanged"><ComboBoxItem Content="实线"/><ComboBoxItem Content="虚线"/><ComboBoxItem Content="点线"/></ComboBox><TextBlock x:Name="SizeLabel" Style="{StaticResource FormLabel}"/><Slider x:Name="SizeSlider" Minimum="2" Maximum="12" TickFrequency="1" ValueChanged="SliderChanged"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Padding="20"><Expander Header="高级选项 / 边缘变暗"><StackPanel Margin="0,16,0,0"><CheckBox x:Name="MaskCheck" Content="启用边缘渐暗" Click="SettingsChanged"/><TextBlock x:Name="WidthLabel"/><Slider x:Name="WidthSlider" Minimum="0.08" Maximum="0.34" TickFrequency="0.01" ValueChanged="SliderChanged"/><TextBlock x:Name="DarknessLabel"/><Slider x:Name="DarknessSlider" Minimum="0.1" Maximum="0.9" TickFrequency="0.01" ValueChanged="SliderChanged"/><CheckBox x:Name="DynamicCheck" Content="转镜头时增强变暗" Click="SettingsChanged"/><TextBlock x:Name="ControllerText" Style="{StaticResource Note}"/><TextBlock x:Name="GainLabel" Margin="0,12,0,0"/><Slider x:Name="GainSlider" Minimum="0.05" Maximum="0.4" TickFrequency="0.01" ValueChanged="SliderChanged"/></StackPanel></Expander></Border>
</StackPanel></ScrollViewer></TabItem></TabControl></Grid>
        <ScrollViewer x:Name="GuidePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,9,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="影之刃零 / 个人清单" Style="{StaticResource Eyebrow}"/><TextBlock Text="先减少镜头自身的刺激" Style="{StaticResource SectionTitle}"/><TextBlock Text="以游戏实际提供的选项为准。勾选只记录进度，不会修改游戏文件。" Style="{StaticResource Note}" Margin="0,0,0,14"/><CheckBox x:Name="BlurCheck" Content="已关闭动态模糊" Click="GuideChanged"/><CheckBox x:Name="ShakeCheck" Content="已降低或关闭镜头晃动" Click="GuideChanged"/><CheckBox x:Name="SensitivityCheck" Content="已检查镜头灵敏度与加速" Click="GuideChanged"/><CheckBox x:Name="ViewCheck" Content="已检查镜头距离 / 视野（若有）" Click="GuideChanged"/><CheckBox x:Name="PacingCheck" Content="已比较帧率与显示设置" Click="GuideChanged"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="我的设置与观察" Style="{StaticResource SectionTitle}"/><TextBox x:Name="GameNotesInput" AcceptsReturn="True" MinHeight="160" TextWrapping="Wrap" LostFocus="GuideChanged" VerticalScrollBarVisibility="Auto"/><Button Content="保存笔记" Click="GuideChanged" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,15,0,0"/></StackPanel></Border></StackPanel><StackPanel Grid.Column="2"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="你的游玩环境" Style="{StaticResource SectionTitle}"/><TextBlock Text="创维 27X4Q" FontSize="22" LineHeight="32"/><TextBlock Text="75 Hz · 约 50–60 FPS · 约 60 cm" Foreground="#377489" FontSize="12" Margin="0,5,0,18"/><Border Height="1" Background="#D9E3E9" Margin="0,0,0,18"/><TextBlock Text="右摇杆转镜头" FontWeight="SemiBold"/><TextBlock Text="尝试降低转向速度和加速，避免一推就猛转；过低也会让操作吃力。" Style="{StaticResource Note}" Margin="0,7,0,18"/><TextBlock Text="走路与跑动" FontWeight="SemiBold"/><TextBlock Text="先比较固定参考元素是否有帮助，遮罩保持关闭。一次只改变一项。" Style="{StaticResource Note}" Margin="0,7,0,18"/><TextBlock Text="帧率稳定性" FontWeight="SemiBold"/><TextBlock Text="比较帧时间波动，再核对垂直同步与可变刷新率。帧率上限应以家中电脑能持续维持的水平为准。" Style="{StaticResource Note}" Margin="0,7,0,0"/></StackPanel></Border></StackPanel></Grid></ScrollViewer>
        <ScrollViewer x:Name="HistoryPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,9,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="个人观察 / 不是医学评分" Style="{StaticResource Eyebrow}"/><TextBlock Text="留下一次实际感受" Style="{StaticResource SectionTitle}"/><TextBlock Text="选择已结束的体验" Style="{StaticResource Note}" Margin="0,8,0,0"/><ComboBox x:Name="HistoryPicker" SelectionChanged="HistorySelected"/><Border Background="#F6F9FB" CornerRadius="7" Padding="13" Margin="0,3,0,19"><TextBlock x:Name="RecordDetails" Style="{StaticResource Note}"/></Border><TextBlock Text="结束时不适程度 / 可留空" Style="{StaticResource Note}"/><ComboBox x:Name="ScorePicker"/><TextBlock Text="场景、途中改动或提前结束的原因" Style="{StaticResource Note}" Margin="0,6,0,7"/><TextBox x:Name="RecordNoteInput" AcceptsReturn="True" Height="130" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><WrapPanel Margin="0,18,0,0"><Button Content="保存评价" Click="SaveRating" Style="{StaticResource Primary}"/><Button Content="导出 CSV" Click="ExportHistory"/></WrapPanel></StackPanel></Border></StackPanel><StackPanel Grid.Column="2"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="怎样比较更有用" Style="{StaticResource SectionTitle}"/><TextBlock Text="01  保持相近场景与时长" Foreground="#377489" FontWeight="SemiBold"/><TextBlock Text="在充分恢复后的不同场次进行短时体验。" Style="{StaticResource Note}" Margin="0,7,0,20"/><TextBlock Text="02  每次只改变一种辅助" Foreground="#377489" FontWeight="SemiBold"/><TextBlock Text="从无辅助开始，再单独尝试角标、侧边短线或参考点，避免同时叠加。" Style="{StaticResource Note}" Margin="0,7,0,20"/><TextBlock Text="03  不适就提前结束" Foreground="#377489" FontWeight="SemiBold"/><TextBlock Text="不用坚持到提醒，也无需为了比较而忍受恶心。评分不能证明因果或临床效果。" Style="{StaticResource Note}" Margin="0,7,0,0"/></StackPanel></Border></StackPanel></Grid></ScrollViewer>
        <ScrollViewer x:Name="HelpPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,9,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="开始一次体验" Style="{StaticResource SectionTitle}"/><TextBlock Text="1. 完整解压程序，运行 StillFrame.exe。&#10;2. 游戏改为无边框全屏，刷新并选择窗口。&#10;3. 默认只计时；在画面实验室选择需要的元素。&#10;4. 点击开始辅助，切回游戏。&#10;5. 结束后记录感受。" LineHeight="29"/><TextBlock Text="关闭主窗口会收起到托盘。真正退出使用托盘或下方按钮；未结束的体验会保存为未评分记录。" Style="{StaticResource Note}" Margin="0,18,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="全局快捷键" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ShortcutList" FontSize="12" LineHeight="29"/><TextBlock x:Name="HotkeyText" Style="{StaticResource Note}" Margin="0,14,0,0"/></StackPanel></Border></StackPanel><StackPanel Grid.Column="2"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="兼容性与本机数据" Style="{StaticResource SectionTitle}"/><TextBlock Text="优先使用 SDR 无边框全屏。独占全屏、HDR 和受保护画面可能限制覆盖层。软件不注入游戏、不改游戏文件，也不拦截手柄输入。&#10;&#10;所有设置与记录保存在本机，不需要账户，不上传遥测。" Style="{StaticResource Note}"/><TextBlock x:Name="DataPathText" Style="{StaticResource Note}" Margin="0,18,0,18"/><Button Content="打开数据目录" Click="OpenData" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}" BorderBrush="#DFD3C9"><StackPanel><TextBlock Text="结束使用" Style="{StaticResource SectionTitle}"/><TextBlock Text="正常退出会保存当前设置和未结束的体验。" Style="{StaticResource Note}"/><Button Content="退出静界" Click="ExitApp" HorizontalAlignment="Left" Margin="0,14,0,0" Background="#F4ECE6" BorderBrush="#CAB6A5"/></StackPanel></Border></StackPanel></Grid></ScrollViewer>
      </Grid>
      <Border Grid.Row="2" BorderBrush="#D6E1E9" BorderThickness="0,1,0,0" Padding="0,12,0,14" Margin="0,13,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse Width="6" Height="6" Fill="#216F81" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock x:Name="StatusText" Grid.Column="1" Text="就绪 · 默认无画面辅助" FontSize="11" Foreground="#5A7486"/></Grid></Border>
    </Grid>
  </Grid>
</Window>
